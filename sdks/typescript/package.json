{
  "name": "@nexus-ipc/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Nexus-IPC.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/vercel-ai": {
      "types": "./dist/adapters/vercel-ai.d.ts",
      "import": "./dist/adapters/vercel-ai.js",
      "require": "./dist/adapters/vercel-ai.cjs"
    },
    "./universal": {
      "types": "./dist/universal.d.ts",
      "import": "./dist/universal.js",
      "require": "./dist/universal.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/adapters/vercel-ai.ts src/universal.ts --format esm,cjs --dts",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
