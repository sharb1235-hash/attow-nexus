NEXUS_DATA_DIR=~/.nexus
NEXUS_BIND_MODE=uds
NEXUS_GRPC_ADDR=127.0.0.1:7821
NEXUS_UDS_PATH=/tmp/nexus.sock
NEXUS_WINDOWS_PIPE_NAME=\\\\.\\pipe\\nexus
NEXUS_HTTP_ADDR=127.0.0.1:7822
NEXUS_METRICS_ADDR=127.0.0.1:7823
NEXUS_AUTH_TOKEN=
NEXUS_REQUIRE_AUTH=true
NEXUS_ALLOW_REMOTE=false
NEXUS_STORE=sqlite
NEXUS_SQLITE_PATH=~/.nexus/nexus.sqlite
NEXUS_ROCKSDB_PATH=~/.nexus/rocksdb
NEXUS_ARTIFACT_DIR=~/.nexus/artifacts
NEXUS_COMPRESSION_THRESHOLD_BYTES=4096
NEXUS_MAX_INLINE_PAYLOAD_BYTES=65536
NEXUS_PERSIST_EPHEMERAL=false
NEXUS_REDACTION_ENABLED=true
NEXUS_ENCRYPTION_AT_REST=false
NEXUS_LOOP_DETECTION_ENABLED=true
NEXUS_MCP_ENABLED=false
NEXUS_OTEL_ENABLED=false
NEXUS_CLUSTER_ENABLED=false
NEXUS_CLUSTER_ROLE=primary
NEXUS_CLUSTER_PRIMARY_ADDR=
NEXUS_CLUSTER_SHARED_TOKEN=

